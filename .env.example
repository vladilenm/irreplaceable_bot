BOT_TOKEN=
TARGET_CHAT_ID=
AI_RADAR_THREAD_ID=
# Cron expressions are evaluated in container TZ=UTC. MSK comments below
# show the rendering of the *default* value (UTC+3); change the value and
# the comment is no longer accurate.
# DIGEST_CRON — default = 09:00 MSK (06:00 UTC).
DIGEST_CRON=0 6 * * *
AI_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
# Для OpenAI-совместимых провайдеров (DeepSeek и т.п.). Оставь пустым для официального OpenAI.
# AI_BASE_URL=https://api.deepseek.com/v1
AI_BASE_URL=
LOG_LEVEL=info
NODE_ENV=development

# Daily thread summaries
THREAD_SUMMARY_THREAD_ID=
# THREAD_SUMMARY_CRON — evaluated in container TZ=UTC. Default = 06:30 MSK (03:30 UTC).
THREAD_SUMMARY_CRON=30 3 * * *
MESSAGE_RETENTION_DAYS=90
# RETENTION_SWEEP_CRON — evaluated in container TZ=UTC. Default = 04:00 MSK (01:00 UTC).
RETENTION_SWEEP_CRON=0 1 * * *
DB_PATH=data/messages.db
# CSV of forum message_thread_id values whose messages should be summarised.
TRACKED_THREAD_IDS=

# Member request matching. Keep disabled while validating the private eval set.
REQUEST_MATCHING_ENABLED=false
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
MEMBER_SYNC_CRON=*/15 * * * *
REQUEST_MATCH_CONCURRENCY=2
REQUEST_QUEUE_LIMIT=50
REQUEST_PROCESSING_TIMEOUT_MINUTES=10
